# Variables de entorno del backend. Copia este archivo como .env y llena los valores.
# En Render se configuran en Environment; en Docker local las pone docker-compose.yml.
# Las que tienen valor aquí ya traen ese valor por defecto si no se definen.

# ── Base de datos (MySQL 8 en local, TiDB en producción) ─────────────────────
DB_URL=jdbc:mysql://localhost:3306/agroruta_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Bogota
DB_USERNAME=agroruta
DB_PASSWORD=
# Conexiones del pool (subirlas solo para pruebas de carga)
DB_POOL_MAX=10
DB_POOL_MIN=2
# Flyway crea las tablas; Hibernate solo valida (no cambiar a update)
DDL_AUTO=validate
SHOW_SQL=false

# ── Seguridad ─────────────────────────────────────────────────────────────────
# Clave para firmar los JWT, en Base64 y de al menos 32 bytes aleatorios.
# Para generarla: openssl rand -base64 48
JWT_SECRET=
# Duración del token de acceso en milisegundos (900000 = 15 min). El frontend lo renueva solo
# con la cookie de sesión, así que no conviene subirlo.
JWT_EXPIRATION=900000
# Días que dura la sesión sin volver a escribir la contraseña (cookie httpOnly)
SESION_DIAS=30
# La cookie de sesión exige https. En local por http con un navegador que no la acepte, poner false
COOKIE_SEGURA=true
# Clave para que GitHub Actions dispare el resumen diario (POST /api/jobs/daily-alerts).
# Vacía = ese endpoint queda apagado.
TAREAS_TOKEN=
# Orígenes permitidos para el frontend, separados por coma (en Spring: app.cors.allowed-origins)
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200

# ── Servicios externos ───────────────────────────────────────────────────────
# Clave de OpenWeatherMap (clima y pronóstico)
WEATHER_API_KEY=

# ── Correos (API de Gmail por HTTPS; sin estas variables los correos solo van al log) ──
# Dirección del frontend, para los enlaces de los correos
FRONTEND_URL=http://localhost:4200
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
CORREO_REMITENTE=
# true = el texto de los correos (con sus enlaces) sale en el log; en producción va en false
CORREO_LOG_CONTENIDO=true
# true = las cuentas nuevas deben confirmar el correo antes de entrar
VERIFICAR_CORREO=true

# ── Copias de seguridad ──────────────────────────────────────────────────────
BACKUP_DIR=backups
BACKUP_RETENTION=10
BACKUP_CRON=0 0 2 * * *
BACKUP_SCHEDULER_ENABLED=true
# --skip-ssl con el MySQL de Docker; vacío en TiDB
BACKUP_SSL_ARG=
# En TiDB (Render) poner false
BACKUP_SINGLE_TRANSACTION=true
# En Windows, si mysqldump no está en el PATH:
#   BACKUP_MYSQLDUMP_PATH=C:/Program Files/MySQL/MySQL Server 8.0/bin/mysqldump.exe
#   BACKUP_MYSQL_PATH=C:/Program Files/MySQL/MySQL Server 8.0/bin/mysql.exe
BACKUP_MYSQLDUMP_PATH=mysqldump
BACKUP_MYSQL_PATH=mysql
